# Product name (optional override; default in packages/web/src/lib/product.ts)
# PRODUCT_NAME=Paplyn
# NEXT_PUBLIC_PRODUCT_NAME=Paplyn

# Deployment mode: saas | selfhosted
DEPLOYMENT_MODE=selfhosted
NEXT_PUBLIC_DEPLOYMENT_MODE=selfhosted

# Database
DATABASE_URL=postgresql://quire:quire@localhost:5432/quire

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — sign-in button hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — sign-in button hidden when unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ORCID OAuth (optional — sign-in button hidden when unset; Public API)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Outbound email (optional — invite emails are skipped when SMTP_USER/SMTP_PASS unset)
# Set all of these on your VPS or in .env; never commit real credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Example (fake values):
# SMTP_HOST=smtp.mail.example.com
# SMTP_PORT=587
# SMTP_USER=paplyn-mailer
# SMTP_PASS=your-smtp-password-here
# SMTP_FROM=Paplyn <noreply@your-domain.com>

# App URLs (production SaaS example)
# BETTER_AUTH_URL=https://paplyn.com
# NEXT_PUBLIC_APP_URL=https://paplyn.com
# NEXT_PUBLIC_COLLAB_URL=wss://paplyn.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
COMPILER_URL=http://localhost:3001

# OpenAI-compatible AI (optional)
# Hosted (SaaS): set GROQ_API_KEY for Groq (default openai/gpt-oss-120b; fallback openai/gpt-oss-20b via OPENAI_MODEL).
# Legacy: gsk-prefixed keys in XAI_API_KEY or OPENAI_API_KEY are treated as Groq when GROQ_API_KEY is unset.
# BYO OpenAI: set OPENAI_API_KEY (and optionally OPENAI_BASE_URL / OPENAI_MODEL).
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Stripe (SaaS mode only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_RESEARCHER=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Self-host admin bootstrap
ORG_NAME=My Organization

# Compile limits
COMPILE_TIMEOUT_MS=60000
COMPILE_MAX_FILE_SIZE_MB=10

# Collab server
COLLAB_PORT=1234
COLLAB_SECRET=change-me-collab-secret
# Internal HTTP base for server-to-server collab calls (replace-text); not exposed to the browser
COLLAB_HTTP_URL=http://collab:1234
# Required for Yjs room persistence (collab service reads DATABASE_URL)
# DATABASE_URL is shared with the web service — see Database section above

# User issue reports (optional — /report submit hidden when unset)
NOTION_USER_REPORTS_TOKEN=
# NOTION_TOKEN=  # alternate name accepted by the app
NOTION_USER_REPORTS_DATABASE_ID=your-notion-database-id
# Cloudflare Turnstile (optional — honeypot + rate limits still apply when unset)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Compiler service
COMPILER_PORT=3001
